# Copy to .env (never commit it). Use dedicated QA accounts: signing in through the API
# signs the same account out of any browser using it (one active session per user).
E2E_APP_URL=https://dev2-online.studiesweekly.com/beta
E2E_API_URL=https://dev2-online-api.studiesweekly.com/api

E2E_TEACHER_USERNAME=
E2E_TEACHER_PASSWORD=
E2E_DISTRICT_ADMIN_USERNAME=
E2E_DISTRICT_ADMIN_PASSWORD=
E2E_SCHOOL_ADMIN_USERNAME=
E2E_SCHOOL_ADMIN_PASSWORD=
E2E_NOFLAG_TEACHER_USERNAME=
E2E_NOFLAG_TEACHER_PASSWORD=

# From the Network tab of a signed-in session (they change per deploy).
# https://<api-id>.execute-api.us-west-2.amazonaws.com/dev/v3
E2E_GW_URL=
# https://<id>.lambda-url.us-west-2.on.aws
E2E_CORE_URL=

# 1 = run the cases that send real Scout turns (spends the accounts' credits).
E2E_AI_TURNS=0

# Optional inputs for specific UI cases.
# e.g. publications/<id>/... a history article (case 4)
E2E_HISTORY_ARTICLE_PATH=
# a chat from before the release (case 12)
E2E_LEGACY_THREAD_TITLE=
# a word in an old chat title (case 14)
E2E_SEARCH_TERM=
# an action chip's button text (case 10)
E2E_CHIP_LABEL=
# the page where that chip shows
E2E_CHIP_PAGE_PATH=
